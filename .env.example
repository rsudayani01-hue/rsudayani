# ===========================================
# RSI DAYANI - Environment Variables Template
# ===========================================
# Copy file ini ke .env.local dan isi dengan credentials Anda

# ===========================================
# SUPABASE
# ===========================================
# Dari: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# CLOUDINARY
# ===========================================
# Dari: Cloudinary Dashboard > Account Details
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=rsudayani_dokumen

# ===========================================
# APP SETTINGS
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="RSI Undayani"
NEXT_PUBLIC_APP_DESCRIPTION="Sistem Manajemen Data Pegawai"

# ===========================================
# EMAIL (untuk notifikasi - Optional)
# ===========================================
# SMTP_EMAIL_HOST=smtp.gmail.com
# SMTP_EMAIL_PORT=587
# SMTP_EMAIL_USER=your-email@gmail.com
# SMTP_EMAIL_PASSWORD=your-app-password

# ===========================================
# NEXT.JS
# ===========================================
NODE_ENV=development

# ===========================================
# CATATAN PENTING:
# ===========================================
# 1. Jangan pernah push .env.local ke GitHub!
# 2. Untuk Vercel, set environment variables di dashboard
# 3. Untuk production, gunakan nilai yang berbeda dari development
